{
  "$schema": "https://biomejs.dev/schemas/2.6.2/schema.json",
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!!**/.turbo",
      "!!**/dist",
      "!!**/coverage",
      "!!**/.expo",
      "!!**/.expo-shared",
      "!!**/playwright-report",
      "!!**/test-results",
      "!!media/raw",
      "!!video/render",
      "!!**/.codex-scratch",
      "!!apps/mobile/android",
      "!!apps/mobile/ios",
      "!**/*.gen.ts",
      "!docs/spec"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 110
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "useImportType": "error",
        "useExportType": "error"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always"
    }
  }
}
