    "s4": {
      "start": 53.6,
      "end": 102,
      "clip": "narration/s4.m4a",
      "speech": [54.1, 100.84],
      "text": "The buyer pays one PayPal invoice. Claude reads every slip, twice. If the readings disagree, a person decides. Code, not AI, works out every share, to the cent, and stops what it can't explain. This slip was counted twice: once from its pink copy. Once fixed, almost eighteen dollars goes back to sixty-three farmers. Two officers sign the same batch: the treasurer at her desk, the chair on his phone. PayPal pays the farmers who have an account. The rest get cash, on the same statement. Nang Celing reads her pay in her own language, or listens. One tap shows the slip behind each peso. And the buyer checks every line, in her own browser.",
      "lines": {
        "4a": {
          "start": 54.1,
          "end": 56.11,
          "text": "The buyer pays one PayPal invoice."
        },
        "4b": {
          "start": 57,
          "end": 62.16,
          "text": "Claude reads every slip, twice. If the readings disagree, a person decides."
        },
        "4c": {
          "start": 63.11,
          "end": 68.75,
          "text": "Code, not AI, works out every share, to the cent, and stops what it can't explain."
        },
        "4d": {
          "start": 69.56,
          "end": 77.71,
          "text": "This slip was counted twice: once from its pink copy. Once fixed, almost eighteen dollars goes back to sixty-three farmers."
        },
        "4e": {
          "start": 78.67,
          "end": 83.83,
          "text": "Two officers sign the same batch: the treasurer at her desk, the chair on his phone."
        },
        "4f": {
          "start": 84.54,
          "end": 89.54,
          "text": "PayPal pays the farmers who have an account. The rest get cash, on the same statement."
        },
        "4g": {
          "start": 90.34,
          "end": 97.13,
          "text": "Nang Celing reads her pay in her own language, or listens. One tap shows the slip behind each peso."
        },
        "4h": {
          "start": 97.99,
          "end": 100.84,
          "text": "And the buyer checks every line, in her own browser."
        }
      },
