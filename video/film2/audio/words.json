    "s6": {
      "start": 112,
      "end": 166,
      "clip": "narration/s6.m4a",
      "speech": [112.5, 160.6],
      "text": "Under the hood, it starts simple: paper in, pay out. Four stages sit between. First, AI reads. Claude reads each slip twice, and code compares the readings. Second, code computes: every share in whole cents, under a rate card hashed before the season. Third, people approve. Two officers sign one fingerprint of the batch, and the server recomputes it before paying. One changed cent voids both signatures. Fourth, PayPal pays: the invoice through PayPal's Agent Toolkit, payouts through our own typed tool, saved first, sent exactly once, confirmed by signed webhooks. Underneath, every step is chained into one ledger.",
      "lines": {
        "simple": {
          "start": 112.5,
          "end": 115.997,
          "text": "Under the hood, it starts simple: paper in, pay out."
        },
        "stages": {
          "start": 116.637,
          "end": 118.147,
          "text": "Four stages sit between."
        },
        "first": {
          "start": 119.267,
          "end": 124.596,
          "text": "First, AI reads. Claude reads each slip twice, and code compares the readings."
        },
        "second": {
          "start": 125.661,
          "end": 132.412,
          "text": "Second, code computes: every share in whole cents, under a rate card hashed before the season."
        },
        "third": {
          "start": 133.382,
          "end": 143.757,
          "text": "Third, people approve. Two officers sign one fingerprint of the batch, and the server recomputes it before paying. One changed cent voids both signatures."
        },
        "fourth": {
          "start": 144.957,
          "end": 156.789,
          "text": "Fourth, PayPal pays: the invoice through PayPal's Agent Toolkit, payouts through our own typed tool, saved first, sent exactly once, confirmed by signed webhooks."
        },
        "under": {
          "start": 157.689,
          "end": 160.6,
          "text": "Underneath, every step is chained into one ledger."
        }
      },
