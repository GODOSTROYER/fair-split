{
  "name": "@fairsplit/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "Fair Split app (Expo SDK 58): member statement, clerk capture, board co-sign. Web export served at /app.",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "web": "expo start --web",
