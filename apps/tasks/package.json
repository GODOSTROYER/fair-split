{
  "name": "@fairsplit/tasks",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Render Workflows entry (registers every TaskName), cron.ts and the inline executor",
  "exports": {
    ".": {
      "types": "./src/lib.ts",
      "default": "./src/lib.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "inline": "tsx src/inline.ts",
    "cron:plan": "tsx src/cron.ts --plan"
  },
  "dependencies": {
    "@renderinc/sdk": "catalog:",
    "pino": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "ajv": "catalog:",
    "msw": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "yaml": "catalog:"
  }
}
