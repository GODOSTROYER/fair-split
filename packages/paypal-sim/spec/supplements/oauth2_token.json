{
  "openapi": "3.0.3",
  "info": {
    "title": "OAuth 2.0 client-credentials token (Fair Split supplement, not a PayPal file)",
    "version": "0.1.0",
    "description": "Hand-written by Fair Split from PayPal's public authentication guide (https://developer.paypal.com/api/rest/authentication/). The Apache-2.0 spec repository has no file for /v1/oauth2/token. The request is application/x-www-form-urlencoded; the simulator parses it into an object before validation."
  },
  "paths": {
    "/v1/oauth2/token": {
      "post": {
        "operationId": "oauth2.token",
        "requestBody": {
          "content": {
            "application/x-www-form-urlencoded": { "schema": { "$ref": "#/components/schemas/token_request" } }
          }
        },
        "responses": {
          "200": { "content": { "application/json": { "schema": { "$ref": "#/components/schemas/token_response" } } } },
          "default": { "content": { "application/json": { "schema": { "$ref": "#/components/schemas/oauth_error" } } } }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "token_request": {
        "type": "object",
        "required": ["grant_type"],
        "properties": {
          "grant_type": { "type": "string", "enum": ["client_credentials"] },
          "scope": { "type": "string", "maxLength": 4000 },
          "response_type": { "type": "string" },
          "ignoreCache": { "type": "string" },
          "return_authn_schemes": { "type": "string" },
          "return_client_metadata": { "type": "string" },
          "return_unconsented_scopes": { "type": "string" }
        }
      },
      "token_response": {
        "type": "object",
        "required": ["scope", "access_token", "token_type", "app_id", "expires_in", "nonce"],
        "properties": {
          "scope": { "type": "string" },
          "access_token": { "type": "string", "minLength": 1 },
          "token_type": { "type": "string", "enum": ["Bearer"] },
          "app_id": { "type": "string", "pattern": "^APP-[0-9A-Z]{17}$" },
          "expires_in": { "type": "integer", "minimum": 1 },
          "nonce": { "type": "string" }
        }
      },
      "oauth_error": {
        "type": "object",
        "required": ["error", "error_description"],
        "properties": {
          "error": { "type": "string" },
          "error_description": { "type": "string" }
        }
      }
    }
  }
}
