{
  "name": "@fairsplit/eval",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Labelled extraction eval with OCR baseline; writes eval/report/latest.json",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "eval": "tsx src/run.ts",
    "eval:replay": "tsx src/run.ts --mode replay --set test",
    "eval:live": "tsx src/run.ts --mode live --set test --cap-usd 3"
  },
  "dependencies": {
    "@fairsplit/ai": "workspace:*",
    "@fairsplit/contracts": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "msw": "catalog:",
    "sharp": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "@types/node": "catalog:"
  }
}
