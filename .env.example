# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
DATABASE_URL=postgres://fairsplit:fairsplit@localhost:5432/fairsplit
PUBLIC_BASE_URL=http://localhost:8787

# PayPal sandbox (US-country accounts only)
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_BUSINESS_EMAIL=
PAYPAL_BUYER_EMAIL=
# comma-separated member payee emails (sandbox personal accounts)
PAYPAL_MEMBER_EMAILS=

# Anthropic (runtime AI)
ANTHROPIC_API_KEY=
AI_DAILY_SPEND_CAP_USD=5

# Google Gemini (offline voiceover tooling only; never deployed)
GEMINI_API_KEY=
GEMINI_API_KEYS_FALLBACK=

# Kill switches
KILL_PAYOUTS=false
KILL_PAYPAL_LIVE=false
KILL_AI_LIVE=false
