# Copy to .env and fill in. Never commit .env. Names are the ones fs-api reads (apps/api/src/env.ts);
# render.yaml declares the same names on Render (apps/tasks/README.md, "Deploying").
NODE_ENV=development
LOG_LEVEL=info

# Database. Locally one owner URL is enough: migrate and fs-api both use it.
DATABASE_URL=postgres://fairsplit:fairsplit@localhost:5432/fairsplit
# Render's shape instead (fs-api builds fs_app's DATABASE_URL from these two at boot, ADR-0005):
# DATABASE_OWNER_URL=
# FS_APP_DB_PASSWORD=

# The public origin for links and pairing QR codes. On Render, RENDER_EXTERNAL_URL is used when unset.
PUBLIC_ORIGIN=http://localhost:8787

# PayPal rail (ADR-0002): the contract-faithful simulator; every PayPal-derived value is labelled
# "Simulated PayPal sandbox". PP_ENV must be sandbox (Fair Split never talks to live PayPal).
PP_ENV=sandbox
PP_MODE=simulator
# Simulator mode: the fake, committed values in packages/paypal-sim/data/accounts.json (the fs-dev app
# locally, fs-judge on Render). Left blank, members get the seed's labelled simulator aliases.
# PP_MODE=sandbox (untested) needs a real US sandbox app here. The older PAYPAL_* spellings are still read.
PP_CLIENT_ID=
PP_CLIENT_SECRET=
PP_WEBHOOK_ID=
PP_BUSINESS_EMAIL=
PP_PAYER_EMAIL=
# member number to e-mail, e.g. M-014=consolacion.bacus@example.org,M-007=dionisio.lapinig@example.org
PP_RECEIVERS=
PP_UNCLAIMED_RECEIVER=

# fs-api secrets. Unset outside production, fs-api uses ephemeral keys and says so at boot.
# FS_COOKIE_SECRET: 32+ characters. FS_LINK_SIGNING_KEY, FS_LEDGER_SIGNING_KEY: 64 lowercase hex each, different:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# FS_OPERATOR_PASSWORD_SCRYPT: node tools/ops-hash-password.mjs
# JUDGE_CODE_SHA256: the runbook's judge-code one-liner (apps/tasks/README.md)
FS_COOKIE_SECRET=
FS_LINK_SIGNING_KEY=
FS_LEDGER_SIGNING_KEY=
FS_OPERATOR_PASSWORD_SCRYPT=
JUDGE_CODE_SHA256=
CRON_SECRET=

# Every task runs inline in fs-api.
EXECUTOR=inline
# /media: unset serves media/public; the Render build assembles apps/api/dist/media (tools/assemble-media.ts).
# STATIC_MEDIA_DIR=

# Kill switches: FS_KILL is the deploy-wide override; the KILL_* booleans are the older spelling.
FS_KILL=
KILL_PAYOUTS=false
KILL_PAYPAL_LIVE=false
KILL_AI_LIVE=false

# Anthropic (live slip reads in development and the eval; never on Render, where Judge Mode replays)
ANTHROPIC_API_KEY=
AI_DAILY_SPEND_CAP_USD=5

# Google Gemini (offline voiceover tooling only; never deployed)
GEMINI_API_KEY=
GEMINI_API_KEYS_FALLBACK=
