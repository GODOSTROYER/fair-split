{
  "name": "@fairsplit/e2e",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "End-to-end harness: a private stack (embedded Postgres, fs-api on the in-process PayPal simulator, the console and /app served by fs-api) driven by Playwright, Chromium only",
  "scripts": {
    "test": "tsx --test run.test.ts film/capture.test.ts film/timeline.test.ts",
    "e2e": "tsx run.ts",
    "e2e:film": "playwright test -c film.config.ts",
    "stack": "tsx stack/cli.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@fairsplit/contracts": "workspace:*",
    "@fairsplit/db": "workspace:*",
    "@fairsplit/domain": "workspace:*",
    "@fairsplit/motion": "workspace:*",
    "@fairsplit/seed": "workspace:*",
    "@playwright/test": "catalog:",
    "@types/node": "catalog:",
    "postgres": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
